# Copy this file to .env and fill in your real key. .env is git-ignored.

# PriceLabs API key (Account Settings > API in the PriceLabs dashboard).
PRICELABS_API_KEY=

# NOTE: the folder daily output gets saved to is NOT set here. It's the
# OUTPUT_DIR line near the top of run_daily.bat. Edit that file if you
# want to change where files are saved.
